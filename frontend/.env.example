# SIVA Crackers frontend settings. Copy to .env if you need to change anything.
# These are public build settings, not secrets (never put passwords or keys here).

# Base path of the Spring Boot API. Keep /api: in development Vite forwards it to the backend.
VITE_API_URL=/api

# true  = use the local sample data in src/mocks (no backend needed)
# false = read everything from the backend (Phase 4 onwards, default)
VITE_USE_MOCKS=false

# Development only: where Vite forwards /api (not included in the built website).
# Port 8081 because another program uses 8080 on this machine.
DEV_API_PROXY_TARGET=http://localhost:8081

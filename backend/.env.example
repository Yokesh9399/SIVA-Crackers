# SIVA Crackers backend – environment variables
#
# Copy to backend/.env (git-ignored) and fill in YOUR OWN values, or set them in
# your shell / hosting platform. Never commit real values. Never paste them in chat.

# --- Required ---
DB_URL=jdbc:mysql://localhost:3306/siva_crackers
DB_USERNAME=siva_app
DB_PASSWORD=
# Random value, at least 32 bytes. Generate one with the command in README.md.
JWT_SECRET=

# --- Optional ---
# JWT_EXPIRY_MINUTES=60
# Default 8080. On this development machine another Java program already uses 8080, so use:
# PORT=8081
# SPRING_PROFILES_ACTIVE=dev

# Keep true outside local development. SameSite: Strict (default) or Lax.
# APP_COOKIE_SECURE=true
# APP_COOKIE_SAME_SITE=Strict

# Only for a frontend hosted on a different origin. Comma-separated exact origins, no wildcards.
# Leave empty in development (the Vite dev server proxies /api).
# CORS_ALLOWED_ORIGINS=

# Load clearly labelled demo catalogue data (Phase 4.3). Off by default.
# APP_SEED_DEMO=false

# One-time creation of the first OWNER account (Phase 4.5). Used only when no OWNER exists.
# Remove these after the first successful start.
# BOOTSTRAP_OWNER_EMAIL=
# BOOTSTRAP_OWNER_PASSWORD=

# Folder for images uploaded in the admin dashboard (Phase 5). Default: backend/uploads (git-ignored).
# On a server, point this at a persistent folder that is backed up.
# APP_UPLOAD_DIR=uploads

# --- Integration tests only (mvn verify -Pintegration) ---
# TEST_DB_URL=jdbc:mysql://localhost:3306/siva_crackers_test
# TEST_DB_USERNAME=siva_app
# TEST_DB_PASSWORD=
